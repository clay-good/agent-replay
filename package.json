{
  "name": "agent-replay",
  "version": "0.2.0",
  "description": "Agent Flight Data Recorder & Replay Engine — time-travel debugging, auto-eval, and what-if sandboxing for AI agents",
  "type": "module",
  "license": "MIT",
  "author": "AgentReplay",
  "bin": {
    "agent-replay": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20.12"
  },
  "keywords": [
    "ai",
    "agent",
    "replay",
    "trace",
    "debug",
    "eval",
    "guardrails",
    "cli",
    "sqlite",
    "observability"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "verify": "npm run typecheck && npm run build && npm test",
    "prepublishOnly": "npm run build"
  },
  "dependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "better-sqlite3": "^12.11.1",
    "blessed": "^0.1.81",
    "boxen": "^8.0.1",
    "chalk": "^5.3.0",
    "cli-table3": "^0.6.5",
    "commander": "^12.1.0",
    "nanoid": "^5.1.16",
    "ora": "^8.1.1",
    "string-width": "^7.2.0",
    "yaml": "^2.8.3"
  },
  "devDependencies": {
    "@types/blessed": "^0.1.25",
    "@types/node": "^22.10.0",
    "@vitest/coverage-v8": "^4.1.10",
    "tsup": "^8.3.5",
    "typescript": "^5.7.2",
    "vitest": "^4.1.0"
  },
  "overrides": {
    "esbuild": "^0.28.1",
    "postcss": "^8.5.26"
  }
}
